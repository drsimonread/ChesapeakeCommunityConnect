# this is a sample of the .env file. Copy this file to .env and fill in the values for your local environment,
# instructions for setting up the .env file can be found in CCCSetupInstructions.md
GOOGLE_API_KEY= your_google_api_key_here
DJANGO_SECRET_KEY= your_django_secret_key_here

# optional: email for password reset links. leave these out locally and the emails are printed in the
# runserver terminal instead. to send real email, uncomment and fill in your mail provider's SMTP details
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_smtp_username
# EMAIL_HOST_PASSWORD=your_smtp_password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Chesapeake Community Connect <noreply@example.com>
